# =============================================================================
# Velixa HR — environment variables
#
# Copy this file to `.env` in the SAME folder (the repo root) and adjust.
# `.env` is git-ignored; `.env.example` is committed. Never put real
# secrets in `.env.example`.
#
# This ONE file is read by three things:
#   1. Docker Compose  (Postgres + Redis container settings)
#   2. Prisma CLI      (migrations, seeding, Studio)
#   3. The NestJS API  (runtime config)
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres — these values create the container AND are used in DATABASE_URL below.
# If you change any of them, change DATABASE_URL to match.
# -----------------------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=localdevpassword
POSTGRES_DB=velixa_hr_dev
POSTGRES_PORT=5432

# Full connection string used by Prisma and the API.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://app:localdevpassword@localhost:5432/velixa_hr_dev?schema=public"

# -----------------------------------------------------------------------------
# Redis — not used by any feature yet. Reserved for background jobs, caching,
# and the notification queue in later phases. Included now so the local
# environment matches production from day one.
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# API (NestJS)
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Authentication (Phase 1)
#
# Two DIFFERENT secrets on purpose: if the access-token secret ever leaks, an
# attacker can mint short-lived access tokens but still cannot mint refresh
# tokens and take over sessions permanently.
#
# Generate real values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# The values below are PLACEHOLDERS. The API refuses to start with them in
# production, and refuses any secret shorter than 32 characters.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32-chars

# How long each token lasts. Short access token limits the damage of a stolen
# one; the refresh token silently renews it so the user is not logged out.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# -----------------------------------------------------------------------------
# Document storage (Phase 1)
#
# Local disk in development. Production swaps this for S3/Azure Blob by adding
# a new StorageService implementation — see apps/api/src/storage.
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# -----------------------------------------------------------------------------
# Notifications and email (Phase 2)
#
# Every leave event raises an IN-APP notification (the bell) and queues an
# EMAIL. The in-app half always works and needs no configuration. The email
# half needs a transport.
#
# EMAIL_TRANSPORT — one of:
#
#   file   Writes a real .eml file into EMAIL_OUTBOX_DIR instead of sending it.
#          Nothing leaves your machine, but the message is genuinely produced
#          and you can double-click the file to read exactly what would have
#          been sent. THIS IS THE DEVELOPMENT DEFAULT and it is how you verify
#          email notifications without paying for a provider.
#
#   smtp   Real delivery. Requires SMTP_HOST (and usually SMTP_USER/PASSWORD).
#          Works with any provider — SendGrid, Postmark, Amazon SES, Microsoft
#          365, or a company mail server.
#
#   none   Do not attempt delivery at all. Deliveries are recorded as SKIPPED,
#          never as sent. This is the default when NODE_ENV=production, so a
#          deployment that forgot to configure email says so instead of
#          pretending. ⚠️ Nothing in this system ever reports an email as
#          delivered unless a transport actually accepted it.
# -----------------------------------------------------------------------------
EMAIL_TRANSPORT=file
EMAIL_FROM="Velixa HR <no-reply@velixa-hr.local>"
EMAIL_OUTBOX_DIR=./outbox

# Only needed when EMAIL_TRANSPORT=smtp. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# The outbox dispatcher: how often it looks for queued email, and how many
# times it retries before marking a delivery FAILED. Set the interval to 0 to
# disable the background timer (the automated tests do this).
NOTIFICATION_DISPATCH_INTERVAL_MS=15000
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BATCH_SIZE=25

# Where the web app lives. Notification emails link back here, and a link in
# an email has to be absolute.
WEB_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Web (Next.js)
# Anything prefixed NEXT_PUBLIC_ is visible in the browser. Never put a secret here.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
