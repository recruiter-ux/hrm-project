# Normalise line endings.
#
# Windows editors write CRLF, but CI runs on Linux and the repo should store
# LF. Without this, a file saved on Windows can show up as "every line
# changed" in a diff. Git converts on the way in and out; you will not notice.
* text=auto eol=lf

# Files that must keep LF even on Windows checkouts (shell scripts break otherwise).
*.sh text eol=lf

# Binary files — never convert these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated. Collapsed in GitHub diffs and excluded from language statistics.
package-lock.json linguist-generated=true -diff
apps/api/prisma/migrations/** linguist-generated=true
