// =============================================================================
// [PROJECT_NAME] — Prisma schema
// Phase 0: Core HR only.
//
// HOW TO READ THIS FILE
//   - A `model` becomes one database table.
//   - `@map` / `@@map` control the real column and table names in Postgres.
//     Prisma code uses camelCase; the database uses snake_case. This matters
//     because the Reporting module will have people writing raw SQL against
//     these tables, and snake_case is the Postgres convention.
//   - `?` after a type means the field is optional (nullable).
//   - `@relation` defines a foreign key — a link between two tables.
//
// TWO WORDS THAT SOUND ALIKE — READ THIS BEFORE ANYTHING ELSE
//   - `Role`       = a JOB TITLE. "Software Engineer", "Recruiter".
//                    What the person is employed to do.
//   - `AccessRole` = a PERMISSION GROUP. "HR Administrator", "Manager".
//                    What the person may do inside this software.
//   They are separate tables because they change independently: promoting an
//   engineer to Senior must not silently grant access to salary data.
//
// AFTER EDITING THIS FILE, run:  npm run prisma:migrate
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
//
// An enum is a fixed list of allowed values, enforced by the database itself.
// Adding a value later is a safe migration; removing or renaming one is not,
// so these lists are deliberately generous.
// =============================================================================

/// Where an employee sits in the employment lifecycle.
///
/// Deliberately NOT part of employment history (see EmploymentAssignment).
/// Status flips often — every leave of absence would otherwise create a new
/// assignment row and drown the genuine job changes.
enum EmploymentStatus {
  PROBATION
  ACTIVE
  ON_LEAVE
  NOTICE_PERIOD
  SUSPENDED
  TERMINATED
}

/// The contractual basis of employment. Drives leave accrual and, later,
/// payroll treatment. Changes over time (intern converting to full-time), so
/// it is recorded on EmploymentAssignment as well.
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

/// Needed by Attendance & Shift Management: a remote employee's "missing
/// check-in" means something very different from an onsite employee's.
enum WorkLocationType {
  ONSITE
  REMOTE
  HYBRID
}

/// Why an employment assignment changed. This is what turns a list of database
/// rows into a readable career history, and it is what Reporting will group by
/// to answer "how many promotions did Engineering make last year?".
enum AssignmentChangeReason {
  HIRE
  PROMOTION
  DEMOTION
  LATERAL_MOVE // Same level, different job title.
  DEPARTMENT_TRANSFER
  MANAGER_CHANGE
  EMPLOYMENT_TYPE_CHANGE // e.g. intern converting to full-time.
  WORK_LOCATION_CHANGE
  REORGANISATION // Org-wide restructure, not a personal change.
  TERMINATION
  DATA_CORRECTION // Fixing a mistake. NOT a real-world event — exclude from reports.
}

/// Categories of employee document. Used for filtering, retention policy, and
/// compliance reporting ("who is missing a signed contract?").
enum DocumentType {
  CONTRACT
  OFFER_LETTER
  NATIONAL_ID
  PASSPORT
  VISA
  WORK_PERMIT
  EDUCATION_CERTIFICATE
  PROFESSIONAL_CERTIFICATION
  RESUME
  TAX_FORM
  BANK_DETAILS
  MEDICAL
  PERFORMANCE_REVIEW
  DISCIPLINARY
  OTHER
}

/// HOW MUCH a permission applies to — the single most important future-proofing
/// decision in this schema.
///
/// Plain English: "can read employees" is not one permission, it is four.
/// An HR admin reads every employee (GLOBAL). A department head reads their
/// department (DEPARTMENT). A team lead reads their direct reports (TEAM).
/// An ordinary employee reads only themselves (SELF).
///
/// Without this, Leave approval, Attendance visibility, and Payroll access all
/// end up as hardcoded `if` statements scattered through the codebase.
enum PermissionScope {
  SELF
  TEAM // The employee's direct reports (walks Employee.managerId).
  DEPARTMENT // The employee's department, including sub-departments.
  GLOBAL
}

// =============================================================================
// EMPLOYEE — the centre of the system
//
// Almost every future module points at this table: Attendance records, Leave
// requests, Payroll runs, Performance reviews, and ATS hires all reference an
// Employee. That makes it the table most expensive to get wrong.
//
// ⚠️ CURRENT STATE vs HISTORY
// The `roleId`, `departmentId`, `managerId`, `employmentType` and
// `workLocationType` fields below are a CACHE of "how things stand today".
// The full history lives in EmploymentAssignment.
//
// These five fields must ONLY ever be written by the same service method that
// writes an assignment row, inside one transaction. See the big comment on
// EmploymentAssignment.
// =============================================================================

model Employee {
  id String @id @default(cuid())

  /// Human-readable staff code (e.g. "HM-0042"). Kept SEPARATE from `id` on
  /// purpose: payroll files, tax documents, and ID badges need a short stable
  /// code, while `id` is an opaque database key that should never appear on
  /// paperwork.
  employeeNumber String @unique @map("employee_number")

  // --- Identity -------------------------------------------------------------
  firstName     String  @map("first_name")
  lastName      String  @map("last_name")
  /// What the person actually goes by, if different from their legal name.
  preferredName String? @map("preferred_name")

  /// Company email. Unique, and the natural join key when the Auth phase adds
  /// login and when integrating with Google Workspace / Slack.
  workEmail String @unique @map("work_email")

  /// Personal email. Required for offboarding (you lose access to the work
  /// address the moment someone leaves) and for the ATS-to-Employee handover.
  personalEmail String? @map("personal_email")

  phoneNumber String? @map("phone_number")

  // --- Sensitive personal data ---------------------------------------------
  // NOTE: `dateOfBirth` and `nationalId` are regulated personal data. They are
  // stored in plain columns for now. Before this system holds real employee
  // records, decide on either Postgres column-level encryption (pgcrypto) or
  // application-level encryption. See PROJECT_NOTES.md → "Open security items".
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  nationalId  String?   @map("national_id")

  // --- Current employment state (CACHE — see warning above) -----------------
  /// Current job title, pointing at the Role table.
  roleId String? @map("role_id")
  role   Role?   @relation("EmployeeCurrentRole", fields: [roleId], references: [id], onDelete: Restrict)

  /// Optional free-text override for people whose card says something more
  /// specific than the standard title — Role "Software Engineer", working
  /// title "Software Engineer II, Platform". Stops the Role table bloating
  /// with a near-duplicate row per person.
  workingTitle String? @map("working_title")

  departmentId String?     @map("department_id")
  department   Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)

  /// Direct manager. Nullable because someone (the CEO) has no manager.
  ///
  /// This one column carries a lot of weight later: Leave approval routing and
  /// Attendance anomaly ESCALATION both walk this chain upward. Escalation
  /// climbs manager -> manager's manager -> department head.
  managerId String?    @map("manager_id")
  manager   Employee?  @relation("EmployeeReportingLine", fields: [managerId], references: [id], onDelete: SetNull)
  reports   Employee[] @relation("EmployeeReportingLine")

  employmentType   EmploymentType   @default(FULL_TIME) @map("employment_type")
  workLocationType WorkLocationType @default(ONSITE) @map("work_location_type")

  // --- Lifecycle ------------------------------------------------------------
  status EmploymentStatus @default(PROBATION)

  /// IANA timezone, e.g. "Asia/Karachi". Attendance is meaningless without it:
  /// a 9am shift is a different instant for every office. Defaulted rather than
  /// left null because backfilling it after attendance data exists is painful.
  timezone String @default("Asia/Karachi")

  hiredAt DateTime @map("hired_at") @db.Date

  /// End of probation. Drives the "confirmation due" dashboard widget.
  probationEndsAt DateTime? @map("probation_ends_at") @db.Date

  /// Last working day. Set on resignation/termination; `status` moves to
  /// TERMINATED separately, because notice periods mean the two differ.
  terminatedAt DateTime? @map("terminated_at") @db.Date

  // --- Soft delete ----------------------------------------------------------
  /// Employee records are NEVER hard-deleted. Tax law, payroll history, and
  /// audit requirements all demand retention after someone leaves.
  ///
  /// WARNING: Prisma does not enforce this automatically. Every query in the
  /// service layer must filter `deletedAt: null`. The Auth/Core phase should
  /// add a Prisma extension so this is applied globally rather than by hand.
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // --- Reverse relations (no columns; these exist so you can query both ways) ---
  assignments         EmploymentAssignment[] @relation("AssignmentEmployee")
  managedAssignments  EmploymentAssignment[] @relation("AssignmentManager")
  recordedAssignments EmploymentAssignment[] @relation("AssignmentRecorder")
  documents           Document[]             @relation("EmployeeDocuments")
  uploadedDocuments   Document[]             @relation("DocumentUploader")
  accessRoles         EmployeeAccessRole[]   @relation("AccessRoleAssignee")
  accessRolesGranted  EmployeeAccessRole[]   @relation("AccessRoleGrantor")
  departmentsHeaded   Department[]           @relation("DepartmentHead")

  // --- Indexes --------------------------------------------------------------
  // An index makes filtering on a column fast. These cover the queries the
  // dashboards and directory screens will run constantly.
  @@index([departmentId])
  @@index([managerId])
  @@index([roleId])
  @@index([status])
  @@index([deletedAt])
  @@index([lastName, firstName])
  @@map("employees")
}

// =============================================================================
// EMPLOYMENT ASSIGNMENT — the career history
//
// WHAT THIS IS, IN PLAIN ENGLISH
// One row = "between these two dates, this person held this job title, in this
// department, reporting to this manager, on these terms."
//
// WHY IT EXISTS
// Without it, the database only knows where someone stands TODAY. Questions
// like "which department was Ali in last March?", "when was Zara promoted?",
// or "what was this person's manager when they filed that leave request?"
// become unanswerable — and Payroll and Reporting both need those answers.
//
// History cannot be reconstructed after the fact, which is why this table
// exists before any real employee data is loaded.
//
// HOW IT WORKS
//   - `effectiveTo = NULL` means "this is the current arrangement".
//   - Exactly ONE row per employee may have `effectiveTo = NULL`.
//   - Changing someone's job means, in ONE transaction:
//       1. set the current row's `effectiveTo` to the day before the change
//       2. insert a new row with `effectiveFrom` = the change date
//       3. update the cached fields on Employee to match the new row
//     All three steps belong in a single service method. Never write those
//     Employee fields from anywhere else.
//
// ⚠️ DATABASE CONSTRAINT THAT PRISMA CANNOT EXPRESS
// Prisma has no syntax for a partial (filtered) unique index, so the
// "only one open assignment per employee" rule must be added by hand.
//
// The SQL must go into the migration BEFORE that migration is applied, so use
// the two-step flow (a normal `migrate dev` writes AND applies in one go,
// leaving nothing to edit):
//
//   1. npm run prisma:migrate -- --create-only
//        Writes prisma/migrations/<timestamp>_<name>/migration.sql, unapplied.
//   2. Open that migration.sql and append:
//
//        CREATE UNIQUE INDEX "employment_assignments_one_current_per_employee"
//          ON "employment_assignments" ("employee_id")
//          WHERE "effective_to" IS NULL;
//
//   3. npm run prisma:migrate
//        Applies the edited file.
//
// Without this index, a bug can leave an employee with two "current" jobs and
// every headcount report silently double-counts them.
// =============================================================================

model EmploymentAssignment {
  id String @id @default(cuid())

  employeeId String   @map("employee_id")
  employee   Employee @relation("AssignmentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  /// The job title held during this period. Required — an assignment with no
  /// job is not a meaningful record.
  roleId String @map("role_id")
  role   Role   @relation("AssignmentRole", fields: [roleId], references: [id], onDelete: Restrict)

  departmentId String     @map("department_id")
  department   Department @relation("AssignmentDepartment", fields: [departmentId], references: [id], onDelete: Restrict)

  /// Nullable — the CEO reports to nobody.
  managerId String?   @map("manager_id")
  manager   Employee? @relation("AssignmentManager", fields: [managerId], references: [id], onDelete: SetNull)

  /// Employment terms are captured here too, because they genuinely change:
  /// an intern converting to full-time is a career event Payroll must see.
  employmentType   EmploymentType   @default(FULL_TIME) @map("employment_type")
  workLocationType WorkLocationType @default(ONSITE) @map("work_location_type")

  // --- The dates that make this "effective-dated" ---------------------------
  /// First day this arrangement applied.
  effectiveFrom DateTime @map("effective_from") @db.Date

  /// Last day it applied. NULL means "still current".
  effectiveTo DateTime? @map("effective_to") @db.Date

  reason AssignmentChangeReason @default(HIRE)

  /// Free text for context a dropdown cannot capture — "covering parental
  /// leave for HM-0004", "role renamed in Q3 restructure".
  notes String?

  /// Who entered this record. Distinct from the employee it describes.
  recordedById String?   @map("recorded_by_id")
  recordedBy   Employee? @relation("AssignmentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// An employee cannot start two different arrangements on the same day.
  /// Doubles as the natural key that lets the seed script re-run safely.
  @@unique([employeeId, effectiveFrom])
  // Covers "give me this person's history, newest first" and the lookups that
  // resolve "who was in department X on date D".
  @@index([employeeId, effectiveTo])
  @@index([departmentId, effectiveFrom])
  @@index([managerId])
  @@index([roleId])
  @@map("employment_assignments")
}

// =============================================================================
// ROLE — job titles
//
// One row per job title the company recognises: "Software Engineer",
// "Recruiter", "Product Designer". NOT about software permissions — that is
// AccessRole, further down.
//
// Kept as its own table rather than free text on Employee so that:
//   - Recruitment can open a requisition against a defined role
//   - Reporting can group headcount by role and job family
//   - Performance can hang competencies and career ladders off it
//   - Payroll can attach salary bands (deliberately not modelled yet)
// =============================================================================

model Role {
  id String @id @default(cuid())

  /// Stable machine code, e.g. "SWE", "SR_SWE", "RECRUITER". Safe to reference
  /// in code and imports; never renamed once in use.
  code String @unique

  /// The human-readable job title as it appears on a contract.
  title String

  description String?

  /// Groups related titles: "Engineering", "Design", "People", "Commercial".
  /// Career ladders and headcount reports are organised by family, and it
  /// avoids needing a separate table just to categorise a few dozen titles.
  jobFamily String? @map("job_family")

  /// Numeric seniority, e.g. 1 = Intern ... 8 = Executive. A plain number
  /// rather than an enum because every company reworks its levelling and a
  /// number can be re-mapped without a database migration. Sortable, which an
  /// enum is not.
  level Int?

  /// Retire a title without deleting it — historical assignments still need to
  /// resolve the name.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Employees currently holding this title.
  currentEmployees Employee[]             @relation("EmployeeCurrentRole")
  /// Every period, past and present, in which anyone held this title.
  assignments      EmploymentAssignment[] @relation("AssignmentRole")

  @@index([jobFamily])
  @@index([isActive])
  @@map("roles")
}

// =============================================================================
// DEPARTMENT — the org chart
// =============================================================================

model Department {
  id String @id @default(cuid())

  /// Short code such as "ENG" or "PEOPLE". Useful in reports and employee
  /// number prefixes, and stable even if the display name is reworded.
  code String @unique
  name String

  description String?

  /// Departments nest: Engineering -> Mobile -> iOS.
  ///
  /// Reporting and Dashboards need roll-ups ("headcount for Engineering and
  /// everything under it"), and DEPARTMENT-scoped permissions need to include
  /// sub-departments. Flat departments cannot express either.
  parentId String?      @map("parent_id")
  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Department[] @relation("DepartmentHierarchy")

  /// The department head. Distinct from the manager chain: it is the fallback
  /// approver when someone's direct manager is unavailable, and the final step
  /// in attendance anomaly escalation.
  ///
  /// `onDelete: SetNull` — if the head's employee record is removed, the
  /// department survives without a head rather than being deleted with them.
  headEmployeeId String?   @map("head_employee_id")
  head           Employee? @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)

  /// Lets a department be retired without deleting it — historical attendance
  /// and payroll records still need to resolve the name.
  isActive Boolean @default(true) @map("is_active")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  members     Employee[]             @relation("DepartmentMembers")
  assignments EmploymentAssignment[] @relation("AssignmentDepartment")

  @@index([parentId])
  @@index([isActive])
  @@map("departments")
}

// =============================================================================
// ACCESS ROLE + PERMISSION — who can do what in the software
//
// This is the access-control half of the system, kept entirely separate from
// job titles. "HR Administrator", "Manager", "Employee" are AccessRoles.
// "Software Engineer" is a Role.
//
// The wiring is:
//   Employee --(EmployeeAccessRole)--> AccessRole --(AccessRolePermission)--> Permission
//
// Both links are many-to-many, and both use an explicit join table so we can
// store extra facts on the link itself (scope, who granted it, when it lapses).
//
// PLANNED, NOT BUILT: a `Role.defaultAccessRoles` link, so that hiring someone
// as a "Recruiter" (job title) automatically grants the "Recruiter" AccessRole.
// It is a pure join table and can be added later with no data migration, so it
// was left out of Phase 0.
// =============================================================================

model AccessRole {
  id String @id @default(cuid())

  /// Machine-readable key used in code, e.g. "hr_admin". Never renamed.
  key  String @unique
  /// Human-readable label shown in the UI, e.g. "HR Administrator".
  name String

  description String?

  /// System access roles are created by seeds/migrations and underpin the
  /// app's own logic. The UI must prevent deleting or renaming them.
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permissions AccessRolePermission[]
  employees   EmployeeAccessRole[]

  @@map("access_roles")
}

model Permission {
  id String @id @default(cuid())

  /// Permissions are expressed as RESOURCE + ACTION rather than free-form
  /// strings, so that every future module registers its permissions the same
  /// way and the admin UI can group them automatically.
  ///
  ///   resource: "employee", "leave_request", "attendance_record", "payslip"
  ///   action:   "read", "create", "update", "delete", "approve", "export"
  resource String
  action   String

  /// Denormalised "resource:action" (e.g. "leave_request:approve"). Redundant
  /// by design — permission checks happen on nearly every request, and one
  /// indexed string lookup beats a two-column comparison.
  key String @unique

  description String?

  /// Which module owns this permission ("core_hr", "leave", "attendance").
  /// Lets the admin screen group hundreds of permissions into readable sections
  /// once every module has registered its own.
  module String @default("core_hr")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accessRoles AccessRolePermission[]

  /// Prevents the same resource+action being registered twice.
  @@unique([resource, action])
  @@index([module])
  @@map("permissions")
}

/// Join table linking AccessRole to Permission.
///
/// This is an EXPLICIT join table (rather than Prisma's implicit many-to-many)
/// specifically so it can carry `scope`. That single extra column is what lets
/// "Manager" and "HR Administrator" both hold `leave_request:approve` while
/// meaning very different things — TEAM for the manager, GLOBAL for HR.
model AccessRolePermission {
  id String @id @default(cuid())

  accessRoleId String     @map("access_role_id")
  accessRole   AccessRole @relation(fields: [accessRoleId], references: [id], onDelete: Cascade)

  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  scope PermissionScope @default(SELF)

  createdAt DateTime @default(now()) @map("created_at")

  /// An access role holds a given permission once. Change the scope rather
  /// than adding a second row.
  @@unique([accessRoleId, permissionId])
  @@index([permissionId])
  @@map("access_role_permissions")
}

/// Join table linking Employee to AccessRole.
///
/// Many-to-many because one person legitimately holds several access roles at
/// once — a team lead who also does recruiting is "Manager" + "Recruiter".
model EmployeeAccessRole {
  id String @id @default(cuid())

  employeeId String   @map("employee_id")
  employee   Employee @relation("AccessRoleAssignee", fields: [employeeId], references: [id], onDelete: Cascade)

  accessRoleId String     @map("access_role_id")
  accessRole   AccessRole @relation(fields: [accessRoleId], references: [id], onDelete: Cascade)

  /// Who granted this access. "Who gave this person access to payroll?" is one
  /// of the first questions any audit asks.
  grantedById String?   @map("granted_by_id")
  grantedBy   Employee? @relation("AccessRoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  grantedAt DateTime @default(now()) @map("granted_at")

  /// Optional expiry, for temporary elevation — e.g. someone covering HR during
  /// a colleague's leave. Null means the access does not expire.
  expiresAt DateTime? @map("expires_at")

  @@unique([employeeId, accessRoleId])
  @@index([accessRoleId])
  @@index([expiresAt])
  @@map("employee_access_roles")
}

// =============================================================================
// DOCUMENT — employee files
//
// TWO DESIGN DECISIONS WORTH KNOWING:
//
// 1. The FILE ITSELF IS NOT STORED HERE. Only metadata plus `storageKey`, a
//    pointer into object storage (S3, Azure Blob, or a local folder in dev).
//    Storing binaries in Postgres bloats the database and makes every backup
//    and migration slower.
//
// 2. OWNERSHIP IS A NULLABLE FOREIGN KEY PER OWNER TYPE. Right now the only
//    owner is an Employee. When the ATS lands, documents will also belong to
//    candidates — that is added as a second nullable `candidateId` column, NOT
//    by turning this into a generic ownerType/ownerId pair. Generic pointers
//    read as flexible but throw away the database's ability to guarantee the
//    referenced row actually exists.
// =============================================================================

model Document {
  id String @id @default(cuid())

  employeeId String   @map("employee_id")
  employee   Employee @relation("EmployeeDocuments", fields: [employeeId], references: [id], onDelete: Cascade)

  type  DocumentType @default(OTHER)
  /// Display name shown in the UI. Defaults to the original filename but is
  /// editable, so it is kept separate from `originalFilename`.
  title String

  description String?

  // --- File metadata --------------------------------------------------------
  /// Path/key in object storage. NOT a public URL — access is granted through
  /// short-lived signed URLs generated per request, so that permission checks
  /// cannot be bypassed by sharing a link.
  storageKey       String @unique @map("storage_key")
  originalFilename String @map("original_filename")
  mimeType         String @map("mime_type")
  sizeBytes        Int    @map("size_bytes")

  /// SHA-256 of the contents. Detects duplicate uploads and proves a file has
  /// not been altered since upload — which is the point of storing a signed
  /// contract in the first place.
  checksum String?

  // --- Compliance -----------------------------------------------------------
  /// Marks documents only HR should see (medical notes, disciplinary records).
  /// Enforced in the service layer against the RBAC tables above.
  isConfidential Boolean @default(false) @map("is_confidential")

  issuedAt DateTime? @map("issued_at") @db.Date

  /// Expiry date, where the document has one — visas, work permits, and
  /// certifications all lapse. Indexed because "what expires in the next 60
  /// days?" becomes a scheduled notification and a compliance report.
  expiresAt DateTime? @map("expires_at") @db.Date

  /// Audit trail: who put this file here.
  uploadedById String?   @map("uploaded_by_id")
  uploadedBy   Employee? @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([employeeId, type])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("documents")
}
